{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build IAR Project",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\IAR Systems\\Embedded Workbench 8.2\\common\\bin\\IarBuild.exe\"",
            "args": [
                "gd32f303.ewp",
                "-build",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "iar",
                    "pattern": {
                        "regexp": "^([^:]*):(\\d+):\\s*(Warning|Error)\\[(\\w+)\\]:\\s*(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean IAR Project",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\IAR Systems\\Embedded Workbench 8.2\\common\\bin\\IarBuild.exe\"",
            "args": [
                "gd32f303.ewp",
                "-clean",
                "Debug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}